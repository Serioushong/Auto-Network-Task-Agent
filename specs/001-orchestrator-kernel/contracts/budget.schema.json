{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-plan-harness.local/contracts/budget.schema.json",
  "title": "Budget",
  "description": "Three-dimensional per-task budget. FR-018. System hard caps enforced at Worker registration time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["wall_clock_ms", "max_tool_calls", "max_tokens"],
  "properties": {
    "wall_clock_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1800000,
      "description": "System hard cap: 30 minutes (1_800_000 ms)."
    },
    "max_tool_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "description": "System hard cap: 200 calls."
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500000,
      "description": "System hard cap: 500_000 tokens."
    }
  }
}
