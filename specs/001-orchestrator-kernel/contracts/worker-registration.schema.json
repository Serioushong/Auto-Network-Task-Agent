{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-plan-harness.local/contracts/worker-registration.schema.json",
  "title": "WorkerRegistration",
  "description": "Worker self-registration payload. FR-007 / FR-018 / FR-025.",
  "type": "object",
  "additionalProperties": false,
  "required": ["workerId", "pid", "capabilities", "resourceLimits"],
  "properties": {
    "workerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Worker self-chosen identifier. Unique within a kernel run."
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "description": "OS process id. Asserted by kernel against its subprocess handle."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Capability"}
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_mb", "cpu_pct", "wall_clock_ms"],
      "properties": {
        "memory_mb": {"type": "integer", "minimum": 16, "maximum": 8192},
        "cpu_pct": {"type": "integer", "minimum": 1, "maximum": 400, "description": "100 = one full core."},
        "wall_clock_ms": {"type": "integer", "minimum": 1, "maximum": 1800000}
      }
    }
  },
  "$defs": {
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "riskLevel", "budget"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 64,
          "description": "Dot-separated lowercase name, e.g. 'echo.say'."
        },
        "riskLevel": {"type": "string", "enum": ["NORMAL", "HIGH_RISK"]},
        "budget": {"$ref": "./budget.schema.json"},
        "description": {"type": "string", "maxLength": 256}
      }
    }
  }
}
