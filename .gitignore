.cursor/cache/
.cursor/logs/
.cursor/state/
.cursor/credentials/
.cursor/*.log

# ---- Spec Kit runtime ----
.specify/cache/
.specify/tmp/

# ---- Local secrets ----
*.secret
*.key
*.pem
